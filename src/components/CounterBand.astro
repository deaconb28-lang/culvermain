---
import { Image } from 'astro:assets';
import coffee from '../assets/coffee.jpg';

const stats = [
  { value: '7 days', label: 'A week' },
  { value: '8–3', label: 'Every day' },
  { value: '1 hr', label: 'Free parking' },
];
---

<section class="counter">
  <div class="counter__grid">
    <Image
      class="counter__img"
      src={coffee}
      widths={[500, 760, 1100]}
      sizes="(max-width: 760px) 100vw, 50vw"
      alt="A barista pouring steamed milk into a blue cup"
      loading="lazy"
    />

    <div class="counter__body">
      <div class="eyebrow eyebrow--sky">The counter</div>
      <h2>Meet here. Stay a while.</h2>
      <p>
        Morning espresso before work, a long lunch with friends, a laptop and a matcha in the
        afternoon light. The room is loud in the best way.
      </p>
      <div class="stats anim-reveal anim-reveal--30">
        {
          stats.map((stat) => (
            <div>
              <div class="stats__value">{stat.value}</div>
              <div class="stats__label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .counter {
    background: var(--navy);
    color: var(--cream);
  }

  .counter__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    align-items: stretch;
  }

  .counter :global(.counter__img) {
    width: 100%;
    height: 100%;
    min-height: 460px;
    object-fit: cover;
    display: block;
  }

  .counter__body {
    padding: clamp(48px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 3.6vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .counter__body p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    max-width: 46ch;
    color: var(--cream-86);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    padding-top: 12px;
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -0.02em;
    color: var(--yellow);
  }

  .stats__label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-70);
    margin-top: 4px;
  }

  @media (max-width: 500px) {
    .counter :global(.counter__img) {
      min-height: 320px;
    }
  }
</style>
