---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.png';
import { site } from '../data/site';
---

<section id="top" class="hero">
  <Picture
    class="hero__img"
    src={heroImage}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    pictureAttributes={{ style: 'display: contents' }}
    widths={[768, 1024, 1440, 1774]}
    sizes="100vw"
    alt="The dining room at Culver & Main, full of guests along the window counter"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <!--
    The handoff's scrim (0.4/0.34/0.62/0.9, top to bottom) leaves the cream
    headline at 1.9:1 against the bright window behind it — well under the 3:1
    the handoff itself asks us to verify. Deepening the gradient enough to fix
    that washes the whole photograph navy, which is not what the room looks
    like.

    So the contrast is carried locally instead, by a dense halo on the type
    (see the text-shadow stack below), and the gradient does only what it is
    good at: settling the bottom edge into the navy marquee that follows. That
    lets the scrim run *lighter* than the handoff's at the top (0.20 vs 0.40)
    and through the middle, so the photo keeps its own colour, while the
    headline measures >=4.6:1.

    Stops are anchored to the bottom in px rather than in percentages, because
    the headline sits a roughly fixed distance off the hero's bottom edge while
    the hero's height varies — percentages slide out from under it on short
    viewports.

    Re-measure if the hero image is ever swapped: `npm run check:contrast`.
  -->
  <div class="hero__scrim"></div>

  <div class="hero__content">
    <div class="hero__headline">
      <h1>A table<br />for the<br />neighborhood</h1>
    </div>

    <div class="hero__aside">
      <p>{site.description}</p>
      <div class="hero__buttons">
        <a class="btn btn--yellow" href="#menus">See the menu</a>
        <a
          class="btn btn--outline-cream"
          href={site.links.order}
          data-track="order_pickup_click"
          data-track-location="hero">Order pickup</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Sized by the design's height, but allowed to grow rather than clip if
       the stacked columns ever need more room at an odd viewport ratio. */
    height: auto;
    min-height: max(540px, min(84vh, 760px));
    display: flex;
    align-items: flex-end;
    background: var(--navy);
    /* Clips the ken burns scale(1.08) so it never widens the page. */
    overflow: hidden;
  }

  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    animation: kenburns 1.8s var(--ease) both;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(11, 42, 91, 0.88) 0px,
      rgba(11, 42, 91, 0.62) 200px,
      rgba(11, 42, 91, 0.32) 470px,
      rgba(11, 42, 91, 0.2) 100%
    );
  }

  .hero__content {
    position: relative;
    /* The 108px keeps the right column clear of the fixed ORDER NOW button. */
    padding: 0 var(--gutter) 108px;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: rise 0.9s var(--ease) 0.12s both;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 8.5vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    color: var(--cream);
    text-transform: uppercase;
    max-width: 14ch;
    /*
      The handoff's single soft shadow, tightened into a halo. This is what
      holds the headline above 3:1 — it darkens the pixels immediately behind
      the letterforms, where it matters, instead of tinting the whole
      photograph. Reads as the design's drop shadow at a glance.
    */
    text-shadow:
      0 1px 6px rgba(11, 42, 91, 0.98),
      0 0 18px rgba(11, 42, 91, 0.92),
      0 0 46px rgba(11, 42, 91, 0.7);
  }

  .hero__aside {
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 10px;
    animation: rise 0.9s var(--ease) 0.34s both;
  }

  .hero__aside p {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--cream);
  }

  .hero__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /*
    "NEIGHBORHOOD" is an authored line, not a wrap — it needs up to 7.4x the
    font size in width at the small end, where Bricolage's optical sizing
    widens the glyphs. Below ~430px the clamp's 48px floor is wider than the
    viewport allows, so cap the type against the content column instead of
    letting the hard break come apart. The cap is slack at every width above
    that, so the specified clamp is what renders on desktop.
  */
  @supports (container-type: inline-size) {
    .hero__content {
      container-type: inline-size;
    }

    h1 {
      font-size: min(clamp(48px, 8.5vw, 132px), 13cqi);
    }
  }

  @media (max-width: 520px) {
    .hero__content {
      padding-top: 140px;
      padding-bottom: 96px;
    }
  }
</style>
