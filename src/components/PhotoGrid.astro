---
import { Image } from 'astro:assets';
import spread from '../assets/spread.webp';
import breakfast from '../assets/breakfast.png';
---

<section id="restaurant" class="grid-section">
  <div class="shell photo-grid anim-reveal anim-reveal--24">
    <figure class="tile tile--large">
      <Image
        src={spread}
        widths={[500, 760, 1040]}
        sizes="(max-width: 720px) 100vw, 58vw"
        alt="A turkey sandwich, beet salad and hot honey fried chicken sandwich set out on the table"
        loading="lazy"
      />
      <figcaption>Made for sharing</figcaption>
    </figure>

    <div class="tile-column">
      <figure class="tile tile--small">
        <Image
          src={breakfast}
            widths={[400, 620, 840]}
          sizes="(max-width: 720px) 100vw, 40vw"
          alt="The Culver Breakfast — poached egg, seared halloumi and toast, with a matcha"
          loading="lazy"
        />
      </figure>

      <div class="pull-quote">
        <p>Seasonal produce, house-cured meats, bread toasted to order.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Sits between About and the menu, both on the cream ground. About's 110px
    bottom padding carries the gap above; the 96px below matches the menu
    section's own top padding, so the navy edge lands where it would have.
  */
  .grid-section {
    padding: 0 var(--gutter) 96px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }

  .tile--large {
    grid-column: span 7;
  }

  .tile-column {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tile {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--r-panel);
  }

  .tile--small {
    flex: 1;
    min-height: 220px;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--r-panel);
  }

  .tile--large :global(img) {
    aspect-ratio: 1 / 1;
    height: auto;
    transition: transform 0.9s var(--ease);
  }

  .tile--large:hover :global(img) {
    transform: scale(1.04);
  }

  .tile--small :global(img) {
    min-height: 220px;
  }

  figcaption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    background: var(--cream);
    color: var(--navy);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 9px 14px;
    border-radius: var(--r-button);
  }

  .pull-quote {
    background: var(--yellow);
    color: var(--navy);
    padding: 30px;
    border-radius: var(--r-panel);
  }

  .pull-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /*
    The 7/5 split is hard-coded 12-column and does not stack on its own.
    Below 720px the tiles become one full-width column.
  */
  @media (max-width: 720px) {
    .grid-section {
      padding-bottom: 64px;
    }

    .photo-grid {
      grid-template-columns: 1fr;
    }

    .tile--large,
    .tile-column {
      grid-column: 1 / -1;
    }

    .tile--small :global(img) {
      aspect-ratio: 4 / 3;
      height: auto;
    }
  }
</style>
