---
import { site } from '../data/site';

const nav = [
  { label: 'Restaurant', href: '#restaurant' },
  { label: 'About', href: '#about' },
  { label: 'Menus', href: '#menus' },
  { label: 'Visit', href: '#visit' },
];
---

<header class="header" id="site-header">
  <a class="logo" href="#top" aria-label={`${site.name} — back to top`}>
    Culver<span class="amp">&amp;</span>Main
  </a>

  <nav class="nav" aria-label="Primary">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="actions">
    <a
      class="btn btn--navy cta"
      href={site.links.order}
      data-track="order_now_click"
      data-track-location="header">Order now</a
    >
    <button
      class="burger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="burger__bar"></span>
      <span class="burger__bar"></span>
      <span class="burger__bar"></span>
    </button>
  </div>
</header>

<!--
  Mobile navigation was not in the design handoff (the README lists it as
  needed for production). It reuses the header's palette: navy drawer, cream
  links, yellow hover, squared corners.
-->
<div class="drawer" id="mobile-nav" data-nav-panel hidden>
  <nav aria-label="Mobile">
    {nav.map((item) => <a href={item.href} data-nav-link>{item.label}</a>)}
  </nav>
  <a
    class="btn btn--yellow drawer__cta"
    href={site.links.order}
    data-track="order_now_click"
    data-track-location="mobile_nav">Order now</a
  >
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--tomato);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 28px;
    border-bottom: 2px solid var(--navy);
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--cream);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo:hover {
    color: var(--cream);
  }

  .amp {
    color: var(--yellow);
  }

  .nav {
    display: flex;
    gap: 34px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav a {
    color: var(--cream);
    transition: color 0.25s ease;
  }

  .nav a:hover {
    color: var(--yellow);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cta {
    padding: 12px 22px;
    white-space: nowrap;
  }

  .burger {
    display: none;
    width: 42px;
    height: 34px;
    padding: 8px 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }

  .burger__bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--cream);
    transition:
      transform 0.3s var(--ease),
      opacity 0.2s ease;
  }

  .burger[aria-expanded='true'] .burger__bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .burger[aria-expanded='true'] .burger__bar:nth-child(2) {
    opacity: 0;
  }

  .burger[aria-expanded='true'] .burger__bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .drawer {
    position: sticky;
    top: var(--header-h);
    z-index: 49;
    background: var(--navy);
    border-bottom: 2px solid var(--navy);
    padding: 22px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .drawer nav a {
    color: var(--cream);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 14px 0;
    border-bottom: 1px solid var(--cream-20);
    transition: color 0.25s ease;
  }

  .drawer nav a:hover {
    color: var(--yellow);
  }

  .drawer__cta {
    align-self: flex-start;
    padding: 14px 24px;
  }

  /* Four links plus the logo and CTA crowd below ~900px — swap to the drawer. */
  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .burger {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .header {
      padding: 12px 18px;
    }

    /* The floating ORDER NOW button carries the conversion at this width. */
    .cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  // Keep --header-h honest so anchor scroll-margin and the drawer offset track
  // the real header height at every width.
  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
  };

  syncHeaderHeight();
  if (header && 'ResizeObserver' in window) {
    new ResizeObserver(syncHeaderHeight).observe(header);
  } else {
    window.addEventListener('resize', syncHeaderHeight);
  }

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // The drawer only exists below 900px; close it if the viewport grows.
    const wide = window.matchMedia('(min-width: 901px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
